# Database
# Locale (SQLite, nessun server richiesto):
DATABASE_URL=file:./partita-lunedi.db
# Produzione (Turso): URL e token da `turso db show --url <db>` e `turso db tokens create <db>`
# DATABASE_URL=libsql://<db>-<org>.turso.io
# Solo per Turso; vuoto con il file locale.
DATABASE_AUTH_TOKEN=

# Stringa casuale lunga, es. `openssl rand -hex 32`
PAYLOAD_SECRET=cambia-questa-stringa

# Storage immagini (Cloudinary). Se vuoto, le immagini vanno su filesystem in ./media
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifiche push (PWA). Genera le chiavi con `npx web-push generate-vapid-keys`.
# La chiave pubblica è inclusa nel bundle al build: va impostata anche su Netlify prima del deploy.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto per i servizi push: URL del sito (https://…) oppure mailto:tua@email
VAPID_SUBJECT=
